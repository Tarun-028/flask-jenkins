pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'python3 -m venv venv'
                sh './venv/bin/pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh './venv/bin/python -m pytest -v'
            }
        }
stage('Deploy') {
    steps {
        sh 'echo "Deploying Flask application..."'
        sh 'JENKINS_NODE_COOKIE=dontKillMe nohup ./venv/bin/python app.py > app.log 2>&1 </dev/null &'
    }
}
    }

}
